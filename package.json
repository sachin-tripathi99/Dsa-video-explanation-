{
  "name": "dryrun-dsa",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "DryRun: a pattern-based DSA learning platform with animated, narrated explainer videos.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "verify": "tsx scripts/verify.ts",
    "verify:videos": "tsx scripts/verify.ts --videos-only",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@fontsource-variable/recursive": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/kalam": "^5.3.0",
    "highlight.js": "^11.12.0",
    "marked": "^12.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  }
}
